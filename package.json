{
  "name": "agentic-browser-mcp",
  "version": "1.0.0",
  "description": "Agentic browser on top of your real Chrome: MCP + HTTP API, token-cheap text perception with pixel coordinates, and a visible agent cursor",
  "main": "src/mcp.js",
  "scripts": {
    "mcp": "node src/mcp.js",
    "http": "node src/http.js",
    "test": "node test/smoke.js",
    "doctor": "node src/doctor.js",
    "watcher": "node src/watcher.js",
    "test:watcher": "node test/watcher.test.js",
    "setup": "node src/setup.js",
    "test:watcher:claude": "node test/watcher.claude-code.test.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "mcp",
    "browser",
    "agent",
    "chrome",
    "cdp",
    "playwright",
    "ai-agents",
    "automation"
  ],
  "author": "Oscar Fonseca",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "agentic-browser-mcp": "src/mcp.js",
    "agentic-browser-http": "src/http.js",
    "agentic-browser-watcher": "src/watcher.js",
    "agentic-browser-setup": "src/setup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "DISCLAIMER.md",
    "LICENSE",
    "README.es.md",
    "README.md",
    "SECURITY.md",
    "docs",
    "examples",
    "scripts",
    "skills",
    "src",
    "watcher.config.example.json"
  ]
}
